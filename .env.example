# Reference values for participant 1 to map into VisionConfig.
# The vision module does not read .env implicitly. Never put secrets in this file.
OLLAMA_HOST=http://127.0.0.1:11434
VISION_MODEL=qwen2.5vl:3b
VISION_SAMPLE_FPS=2
VISION_MAX_SECONDS=300
VISION_MAX_VLM_CALLS=6
VISION_TIMEOUT_SECONDS=60
VISION_NUM_CTX=2048
VISION_NUM_PREDICT=200
VISION_MAX_IMAGES=1
VISION_MAX_IMAGE_SIDE=1024
VISION_OUTPUT_DIR=artifacts/vision
# Set camera profile only after real calibration. Demo coordinates stay disabled.
VISION_ROI_PATH=configs/roi.json
VISION_CAMERA_PROFILE=
